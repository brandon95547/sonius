{
  "name": "sonius",
  "version": "0.1.0",
  "private": true,
  "description": "A showcase of style guides to use as reference.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build-css.mjs",
    "start": "npm run build && node server.js",
    "dev": "concurrently -n css,srv \"node scripts/build-css.mjs --watch\" \"node --watch server.js\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "tailwindcss": "^4.1.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vitest": "^3.2.4"
  }
}
