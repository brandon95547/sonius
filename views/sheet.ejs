<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= guide.name %> — Sonius</title>
  <%# The guide's own bundle: Tailwind, the shared components (styles/components.css) and this
      guide's theme (guides/<id>/theme.css), built by scripts/build-css.mjs. Every value on the
      page is read back from it as it loads — no hex is written here. %>
  <link rel="stylesheet" href="/guides/<%= guide.id %>.css">
  <link rel="stylesheet" href="/css/sheet.css">
  <script src="/vendor/lucide.min.js"></script>
</head>

<%# The body classes every guide is drawn on. Every demo sits inside <main class="dash-surface">,
    as every page of the product it came from does: that is what makes a .card a level-1 panel
    here. Every value on this page is read from the guide's bundle as it loads — no hex is
    written here. %>
<body class="min-h-screen bg-surface-950 text-surface-100 antialiased">

  <header class="sg-header">
    <div class="sg-wrap">
      <p class="sg-eyebrow"><a class="sg-link" href="/">Sonius</a> · Style guide</p>
      <h1 class="sg-h1"><%= guide.name %></h1>
      <p class="sg-lede"><%= guide.summary %></p>
      <% if (guide.source) { %>
        <p class="sg-aside">From <a class="sg-link" href="<%= guide.source.url %>" rel="noopener"><%= guide.source.label %></a>.</p>
      <% } %>
    </div>
  </header>

  <nav class="sg-nav" aria-label="Sections">
    <div class="sg-wrap">
      <a href="#colors">Colors</a>
      <a href="#surfaces">Surfaces</a>
      <a href="#type">Typography</a>
      <a href="#buttons">Buttons</a>
      <a href="#forms">Forms</a>
      <a href="#navigation">Navigation</a>
      <a href="#cards">Cards &amp; data</a>
      <a href="#status">Status</a>
      <a href="#dialogs">Dialogs &amp; menus</a>
    </div>
  </nav>

  <main class="dash-surface">

    <!-- ───────────────────────────────── Colors ─────────────────────────────── -->
    <!-- Each figure names its token in data-sg-token; the script reads the value back from
         the bundle into [data-sg-value]. Fills and inks are inline var(), never a hex. -->
    <section id="colors" class="sg-section">
      <div class="sg-wrap">
        <h2 class="sg-h2">Colors</h2>
        <p class="sg-p">
          A monochrome interface with one brand hue. Grey carries the interface, violet marks the
          brand, and status keeps its color because the color is the message.
        </p>

        <h3 class="sg-h3">Core</h3>
        <div class="sg-colors sg-mt">
          <figure class="sg-color" data-sg-token="--mono-accent">
            <div class="sg-color__fill" style="background-color: var(--mono-accent); color: var(--mono-on-accent)"><span>Aa</span></div>
            <figcaption class="sg-color__body">
              <span class="sg-color__name">Primary</span>
              <span class="sg-color__value" data-sg-value></span>
              <code class="sg-color__token">--mono-accent · primary-500</code>
              <span class="sg-color__use">The primary button, the selected pill, the sidebar's call to action. One per view.</span>
            </figcaption>
            <div class="sg-states">
              <span class="sg-state" data-sg-token="--mono-accent-hover"><span class="sg-state__chip" style="background-color: var(--mono-accent-hover)"></span><span class="sg-state__label">Hover</span><span class="sg-state__value" data-sg-value></span></span>
              <span class="sg-state" data-sg-token="--mono-accent-active"><span class="sg-state__chip" style="background-color: var(--mono-accent-active)"></span><span class="sg-state__label">Pressed</span><span class="sg-state__value" data-sg-value></span></span>
              <span class="sg-state" data-sg-token="--mono-on-accent"><span class="sg-state__chip" style="background-color: var(--mono-on-accent)"></span><span class="sg-state__label">On primary</span><span class="sg-state__value" data-sg-value></span></span>
            </div>
          </figure>

          <figure class="sg-color" data-sg-token="--ui-fill-success">
            <div class="sg-color__fill" style="background-color: var(--ui-fill-success); color: var(--mono-on-accent)"><span>Aa</span></div>
            <figcaption class="sg-color__body">
              <span class="sg-color__name">Secondary</span>
              <span class="sg-color__value" data-sg-value></span>
              <code class="sg-color__token">--ui-fill-success · emerald-400</code>
              <span class="sg-color__use">The secondary button (Recharge), a switch that is on, a finished state.</span>
            </figcaption>
            <div class="sg-states">
              <span class="sg-state" data-sg-token="--ui-fill-success-hover"><span class="sg-state__chip" style="background-color: var(--ui-fill-success-hover)"></span><span class="sg-state__label">Hover</span><span class="sg-state__value" data-sg-value></span></span>
              <span class="sg-state" data-sg-token="--mono-on-accent"><span class="sg-state__chip" style="background-color: var(--mono-on-accent)"></span><span class="sg-state__label">On secondary</span><span class="sg-state__value" data-sg-value></span></span>
            </div>
          </figure>

          <figure class="sg-color" data-sg-token="--color-violet-500">
            <div class="sg-color__fill" style="background-color: var(--color-violet-500); color: var(--studio-on-accent)"><span>Aa</span></div>
            <figcaption class="sg-color__body">
              <span class="sg-color__name">Brand</span>
              <span class="sg-color__value" data-sg-value></span>
              <code class="sg-color__token">--color-violet-500</code>
              <span class="sg-color__use">The current tab's underline, a selected card in the studios, the home page's glow.</span>
            </figcaption>
            <div class="sg-states">
              <span class="sg-state" data-sg-token="--studio-accent-hover"><span class="sg-state__chip" style="background-color: var(--studio-accent-hover)"></span><span class="sg-state__label">Hover</span><span class="sg-state__value" data-sg-value></span></span>
              <span class="sg-state" data-sg-token="--studio-accent-press"><span class="sg-state__chip" style="background-color: var(--studio-accent-press)"></span><span class="sg-state__label">Pressed</span><span class="sg-state__value" data-sg-value></span></span>
              <span class="sg-state" data-sg-token="--studio-accent-text"><span class="sg-state__chip" style="background-color: var(--studio-accent-text)"></span><span class="sg-state__label">As text</span><span class="sg-state__value" data-sg-value></span></span>
            </div>
          </figure>

          <figure class="sg-color" data-sg-token="--elev-0">
            <div class="sg-color__fill" style="background-color: var(--elev-0); color: var(--color-surface-100)"><span>Aa</span></div>
            <figcaption class="sg-color__body">
              <span class="sg-color__name">Background</span>
              <span class="sg-color__value" data-sg-value></span>
              <code class="sg-color__token">--elev-0 · surface-950</code>
              <span class="sg-color__use">The page and the sidebar. Everything else stands on it — see Surfaces.</span>
            </figcaption>
            <div class="sg-states">
              <span class="sg-state" data-sg-token="--color-surface-100"><span class="sg-state__chip" style="background-color: var(--color-surface-100)"></span><span class="sg-state__label">On background</span><span class="sg-state__value" data-sg-value></span></span>
            </div>
          </figure>
        </div>

        <h3 class="sg-h3">Text</h3>
        <div class="sg-inks sg-mt">
          <div class="sg-ink" data-sg-token="--color-surface-100">
            <span class="sg-ink__sample" style="color: var(--color-surface-100)">Aa</span>
            <span class="sg-ink__line" style="color: var(--color-surface-100)">Headings and body</span>
            <span class="sg-label">Primary · text-surface-100</span>
            <span class="sg-meta" data-sg-value></span>
          </div>
          <div class="sg-ink" data-sg-token="--color-surface-200">
            <span class="sg-ink__sample" style="color: var(--color-surface-200)">Aa</span>
            <span class="sg-ink__line" style="color: var(--color-surface-200)">Descriptions, labels</span>
            <span class="sg-label">Secondary · text-surface-200</span>
            <span class="sg-meta" data-sg-value></span>
          </div>
          <div class="sg-ink" data-sg-token="--color-surface-400">
            <span class="sg-ink__sample" style="color: var(--color-surface-400)">Aa</span>
            <span class="sg-ink__line" style="color: var(--color-surface-400)">Captions, placeholders</span>
            <span class="sg-label">Muted · text-surface-400</span>
            <span class="sg-meta" data-sg-value></span>
          </div>
          <div class="sg-ink" data-sg-token="--color-surface-500">
            <span class="sg-ink__sample" style="color: var(--color-surface-500)">Aa</span>
            <span class="sg-ink__line" style="color: var(--color-surface-500)">Disabled, separators</span>
            <span class="sg-label">Disabled · text-surface-500</span>
            <span class="sg-meta" data-sg-value></span>
          </div>
        </div>

        <h3 class="sg-h3">Status</h3>
        <div class="sg-pairs sg-mt">
          <figure class="sg-pair">
            <div class="sg-pair__fills">
              <span class="sg-pair__ink" style="color: var(--ui-color-success)">Saved</span>
              <span class="sg-pair__fill" style="background-color: var(--ui-fill-success)">Fill</span>
            </div>
            <figcaption class="sg-pair__body">
              <span class="sg-color__name">Success</span>
              <span class="sg-color__value"><span data-sg-token="--ui-color-success"><span data-sg-value></span></span> · <span data-sg-token="--ui-fill-success"><span data-sg-value></span></span></span>
              <code class="sg-color__token">--ui-color-success · --ui-fill-success</code>
            </figcaption>
          </figure>
          <figure class="sg-pair">
            <div class="sg-pair__fills">
              <span class="sg-pair__ink" style="color: var(--ui-color-warning)">Running low</span>
              <span class="sg-pair__fill" style="background-color: var(--ui-fill-warning)">Fill</span>
            </div>
            <figcaption class="sg-pair__body">
              <span class="sg-color__name">Warning</span>
              <span class="sg-color__value"><span data-sg-token="--ui-color-warning"><span data-sg-value></span></span> · <span data-sg-token="--ui-fill-warning"><span data-sg-value></span></span></span>
              <code class="sg-color__token">--ui-color-warning · --ui-fill-warning</code>
            </figcaption>
          </figure>
          <figure class="sg-pair">
            <div class="sg-pair__fills">
              <span class="sg-pair__ink" style="color: var(--ui-color-error)">Failed</span>
              <span class="sg-pair__fill" style="background-color: var(--ui-fill-error)">Fill</span>
            </div>
            <figcaption class="sg-pair__body">
              <span class="sg-color__name">Error</span>
              <span class="sg-color__value"><span data-sg-token="--ui-color-error"><span data-sg-value></span></span> · <span data-sg-token="--ui-fill-error"><span data-sg-value></span></span></span>
              <code class="sg-color__token">--ui-color-error · --ui-fill-error</code>
            </figcaption>
          </figure>
          <figure class="sg-pair">
            <div class="sg-pair__fills">
              <span class="sg-pair__ink" style="color: var(--ui-color-info)">Processing</span>
              <span class="sg-pair__fill" style="background-color: var(--dialog-info-btn)">Fill</span>
            </div>
            <figcaption class="sg-pair__body">
              <span class="sg-color__name">Info</span>
              <span class="sg-color__value"><span data-sg-token="--ui-color-info"><span data-sg-value></span></span></span>
              <code class="sg-color__token">--ui-color-info</code>
            </figcaption>
          </figure>
        </div>

        <h3 class="sg-h3">Special cases</h3>
        <p class="sg-p">The few places an edge or a color means something on its own. Each is drawn as it ships.</p>
        <div class="sg-specials sg-mt">
          <!-- The recommended plan, as partials/admin/upgrade-dialog.ejs and dashboard-checkout.ejs draw it. -->
          <div class="sg-special">
            <div class="sg-special__stage">
              <div class="relative flex flex-col rounded-2xl border border-primary-500 ring-2 ring-primary-500/40 bg-surface-950/40 p-5">
                <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-primary-500 px-3 py-0.5 text-overline uppercase text-surface-950">Recommended</span>
                <h3 class="text-h3 text-surface-100">Pro</h3>
                <div class="mt-2 flex items-baseline gap-1">
                  <span class="text-h1 text-surface-100">$30</span>
                  <span class="text-body-sm font-medium text-surface-200">/month</span>
                </div>
              </div>
            </div>
            <div class="sg-special__body">
              <span class="sg-color__name">Premium · recommended</span>
              <code class="sg-color__token">border-primary-500 ring-2 ring-primary-500/40</code>
              <span class="sg-color__use">The recommended plan, and only that. Every other plan takes border-surface-800.</span>
            </div>
          </div>

          <!-- Talari's selected cards: .talari-radio-card.is-selected and friends in dashboard.css. -->
          <div class="sg-special">
            <div class="sg-special__stage">
              <div class="sg-edge sg-edge--selected" style="border-color: var(--studio-accent-edge); background-color: var(--studio-accent-wash); color: var(--color-surface-100)">Illustrated story</div>
            </div>
            <div class="sg-special__body">
              <span class="sg-color__name">Selected card</span>
              <code class="sg-color__token">--studio-accent-edge · --studio-accent-wash</code>
              <span class="sg-color__use">A chosen option in a studio: violet edge, a wash of it behind.</span>
            </div>
          </div>

          <div class="sg-special">
            <div class="sg-special__stage">
              <div class="sg-row">
                <span class="cost-tag"><i data-lucide="zap" class="h-3.5 w-3.5"></i>1,200</span>
                <button type="button" class="btn btn--filled btn--sm"><i data-lucide="sparkles" class="h-4 w-4"></i>Generate</button>
              </div>
            </div>
            <div class="sg-special__body">
              <span class="sg-color__name">Credits</span>
              <code class="sg-color__token">.cost-tag · amber-400</code>
              <span class="sg-color__use">The bolt beside a price. The mark carries the color; the number stays grey.</span>
            </div>
          </div>

          <div class="sg-special">
            <div class="sg-special__stage">
              <div class="sg-edge" style="border-color: var(--ui-fill-danger-edge); background-color: var(--ui-fill-danger-wash); color: var(--ui-fill-danger-text)">Delete this project</div>
            </div>
            <div class="sg-special__body">
              <span class="sg-color__name">Destructive</span>
              <code class="sg-color__token">--ui-fill-danger-edge · -wash · -text</code>
              <span class="sg-color__use">Around an action that cannot be undone, and an invalid field's edge.</span>
            </div>
          </div>
        </div>

        <h3 class="sg-h3">Lines &amp; layers</h3>
        <p class="sg-p">White at low strength, so one value works on every surface.</p>
        <div class="sg-layers sg-mt">
          <div class="sg-layer-demo" data-sg-token="--ui-border">
            <div class="sg-layer-demo__stage sg-layer-demo__stage--line" style="border-color: var(--ui-border)"></div>
            <span class="sg-label">Border</span>
            <code class="sg-meta">--ui-border · <span data-sg-value></span></code>
          </div>
          <div class="sg-layer-demo" data-sg-token="--ui-border-strong">
            <div class="sg-layer-demo__stage sg-layer-demo__stage--line" style="border-color: var(--ui-border-strong)"></div>
            <span class="sg-label">Strong border</span>
            <code class="sg-meta">--ui-border-strong · <span data-sg-value></span></code>
          </div>
          <div class="sg-layer-demo" data-sg-token="--ui-layer-hover">
            <div class="sg-layer-demo__stage"><div class="ui-layer-hover h-full rounded-xl"></div></div>
            <span class="sg-label">Hover</span>
            <code class="sg-meta">.ui-layer-hover · <span data-sg-value></span></code>
          </div>
          <div class="sg-layer-demo" data-sg-token="--ui-layer-selected">
            <div class="sg-layer-demo__stage"><div class="ui-layer-selected h-full rounded-xl"></div></div>
            <span class="sg-label">Selected</span>
            <code class="sg-meta">.ui-layer-selected · <span data-sg-value></span></code>
          </div>
          <div class="sg-layer-demo" data-sg-token="--ui-scrim">
            <div class="sg-layer-demo__stage"><div class="ui-scrim h-full rounded-xl"></div></div>
            <span class="sg-label">Scrim</span>
            <code class="sg-meta">.ui-scrim · <span data-sg-value></span></code>
          </div>
        </div>

        <!-- Every color the theme defines, merged by value, for looking one up. -->
        <details class="sg-details">
          <summary>All color tokens</summary>
          <div class="sg-scroll">
            <table id="sg-tokens" class="sg-tokens"></table>
          </div>
        </details>
      </div>
    </section>

    <!-- ──────────────────────────────── Surfaces ────────────────────────────── -->
    <section id="surfaces" class="sg-section">
      <div class="sg-wrap">
        <h2 class="sg-h2">Surfaces</h2>
        <p class="sg-p">Depth is lightness: whatever rests on a surface is one step lighter than it.</p>

        <h3 class="sg-h3">Elevation, dark to light</h3>
        <div class="sg-ladder sg-mt">
          <div class="sg-rung" style="background-color: var(--elev-0)" data-sg-token="--elev-0">
            <span class="sg-rung__level">Level 0</span>
            <span class="sg-rung__name">Page</span>
            <span class="sg-rung__use">The ground, and the sidebar</span>
            <code class="sg-rung__value">--elev-0 · <span data-sg-value></span></code>
          </div>
          <div class="sg-rung sg-rung--1" style="background-color: var(--elev-1)" data-sg-token="--elev-1">
            <span class="sg-rung__level">Level 1</span>
            <span class="sg-rung__name">Card</span>
            <span class="sg-rung__use">Panels and cards on the page</span>
            <code class="sg-rung__value">--elev-1 · <span data-sg-value></span></code>
          </div>
          <div class="sg-rung sg-rung--2" style="background-color: var(--elev-2)" data-sg-token="--elev-2">
            <span class="sg-rung__level">Level 2</span>
            <span class="sg-rung__name">Raised</span>
            <span class="sg-rung__use">Lifted cards, dialogs, drawers</span>
            <code class="sg-rung__value">--elev-2 · <span data-sg-value></span></code>
          </div>
          <div class="sg-rung sg-rung--3" style="background-color: var(--elev-3)" data-sg-token="--elev-3">
            <span class="sg-rung__level">Level 3</span>
            <span class="sg-rung__name">Overlay</span>
            <span class="sg-rung__use">Boxes on a dialog, menus</span>
            <code class="sg-rung__value">--elev-3 · <span data-sg-value></span></code>
          </div>
          <div class="sg-rung sg-rung--4" style="background-color: var(--elev-4)" data-sg-token="--elev-4">
            <span class="sg-rung__level">Level 4</span>
            <span class="sg-rung__name">Field</span>
            <span class="sg-rung__use">Inputs and selects, above every surface</span>
            <code class="sg-rung__value">--elev-4 · <span data-sg-value></span></code>
          </div>
        </div>
        <p class="sg-p sg-mt" data-sg-token="--ui-well">
          One surface sits outside the ladder: the <strong>well</strong>
          (<code class="sg-code">--ui-well</code>, <span data-sg-value></span>), a track cut into a surface —
          a meter, a segmented control, a fader rail. Inside a dialog it also stands in for level 0.
        </p>

        <h3 class="sg-h3">Stacking</h3>
        <div class="card sg-mt">
          <p class="card__title">.card — level 1</p>
          <p class="card__desc">On a dashboard page a card is a panel on the ground.</p>
          <div class="card elev-2 sg-mt">
            <p class="card__title">.card.elev-2 — level 2</p>
            <p class="card__desc">The usage tiles, the Chrono Origin trace form.</p>
            <div class="rounded-xl border border-[var(--ui-border)] elev-3 p-5 sg-mt">
              <p class="card__title">.elev-3 — level 3, a box on a lifted card</p>
              <div class="field sg-mt">
                <label class="field__label" for="sg-stack-field">.input — level 4, fields sit above every surface</label>
                <input class="input" id="sg-stack-field" type="text" placeholder="Type here">
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─────────────────────────────── Typography ───────────────────────────── -->
    <!-- The most common pattern for each role across views/dashboard*.ejs. -->
    <section id="type" class="sg-section">
      <div class="sg-wrap">
        <h2 class="sg-h2">Typography</h2>
        <p class="sg-p">One scale for the site and the dashboard, from the UI Bible. Nothing readable under 12px.</p>

        <div class="card sg-mt">
          <div class="sg-type">
            <div class="sg-type__row">
              <p class="sg-type__role">Page title</p>
              <div class="sg-type__sample">
                <p class="text-h1 text-surface-100">Research Atlas</p>
                <code class="sg-meta">text-h1 — 40/56 · 300</code>
              </div>
            </div>
            <div class="sg-type__row">
              <p class="sg-type__role">Dialog / major section</p>
              <div class="sg-type__sample">
                <p class="text-h2 text-surface-100">Upgrade your plan</p>
                <code class="sg-meta">text-h2 — 24/32 · 500 · −0.025em</code>
              </div>
            </div>
            <div class="sg-type__row">
              <p class="sg-type__role">Section heading</p>
              <div class="sg-type__sample">
                <p class="text-h3 text-surface-100">Recent Activity</p>
                <code class="sg-meta">text-h3 — 18/24 · 600</code>
              </div>
            </div>
            <div class="sg-type__row">
              <p class="sg-type__role">Card title</p>
              <div class="sg-type__sample">
                <p class="text-h4 text-surface-100">Text to Speech</p>
                <code class="sg-meta">text-h4 — 16/24 · 500</code>
              </div>
            </div>
            <div class="sg-type__row">
              <p class="sg-type__role">Body</p>
              <div class="sg-type__sample">
                <p class="text-body text-surface-100">Paste your text, pick a voice and generate.</p>
                <code class="sg-meta">text-body — 16/24 · 400</code>
              </div>
            </div>
            <div class="sg-type__row">
              <p class="sg-type__role">Interface</p>
              <div class="sg-type__sample">
                <p class="text-ui text-surface-100">Narrava Studio</p>
                <code class="sg-meta">text-ui — 15/21 · 400 (nav, menus, rows, tabs)</code>
              </div>
            </div>
            <div class="sg-type__row">
              <p class="sg-type__role">Form label</p>
              <div class="sg-type__sample">
                <p class="text-label text-surface-100">Story title</p>
                <code class="sg-meta">text-label — 15/24 · 500</code>
              </div>
            </div>
            <div class="sg-type__row">
              <p class="sg-type__role">Supporting</p>
              <div class="sg-type__sample">
                <p class="text-body-sm text-surface-200">Your latest generations across all products.</p>
                <code class="sg-meta">text-body-sm — 14/20 · 400</code>
              </div>
            </div>
            <div class="sg-type__row">
              <p class="sg-type__role">Eyebrow</p>
              <div class="sg-type__sample">
